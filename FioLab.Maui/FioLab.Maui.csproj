<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>FioLab.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationTitle>FioLab</ApplicationTitle>
    <ApplicationId>com.timachado.fiolab.maui</ApplicationId>
    <ApplicationDisplayVersion>0.70.0</ApplicationDisplayVersion>
    <ApplicationVersion>110</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <UseMaterial3>true</UseMaterial3>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../FioLab.Engine/FioLab.Engine.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.151.2" />
  </ItemGroup>
</Project>
